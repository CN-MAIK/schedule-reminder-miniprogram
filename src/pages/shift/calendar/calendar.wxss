/* 排班月历页样式 */

.container {
  min-height: 100vh;
  background: #f8f9fa;
  padding: 24rpx;
  padding-bottom: 60rpx;
}

/* ========== 空状态 ========== */
.empty-guide { display: flex; flex-direction: column; align-items: center; padding-top: 240rpx; }
.guide-icon { font-size: 128rpx; margin-bottom: 24rpx; }
.guide-title { font-size: 32rpx; color: #999; margin-bottom: 32rpx; }
.guide-btn { background: #07c160; color: #fff; font-size: 28rpx; border-radius: 40rpx; padding: 14rpx 48rpx; }

/* ========== 月份切换 ========== */
.calendar-header {
  display: flex; justify-content: space-between; align-items: center;
  margin-bottom: 28rpx;
}
.arrow-btn { width: 64rpx; height: 64rpx; display: flex; align-items: center; justify-content: center; }
.arrow { font-size: 28rpx; color: #999; }
.arrow-disabled { opacity: 0.25; pointer-events: none; }
.month-title { font-size: 30rpx; font-weight: 600; color: #1a1a1a; }

/* ========== 星期标题 ========== */
.weekdays { display: flex; margin-bottom: 8rpx; }
.weekday { flex: 1; text-align: center; font-size: 24rpx; color: #bbb; padding: 12rpx 0; }

/* ========== 日期网格 ========== */
.days-grid { display: flex; flex-wrap: wrap; background: #fff; border-radius: 16rpx; overflow: hidden; }
.day-cell {
  width: calc(100% / 7);
  min-height: 110rpx;
  display: flex; flex-direction: column; align-items: center;
  padding: 10rpx 0 6rpx;
  border-bottom: 1rpx solid #f5f5f5;
  border-right: 1rpx solid #f5f5f5;
  box-sizing: border-box;
}
.day-cell:nth-child(7n) { border-right: none; }
.day-cell.other-month { opacity: 0.35; }
.day-num { font-size: 26rpx; color: #333; margin-bottom: 6rpx; }
.day-cell.today { background: #e8f8ee; }
.day-cell.today .day-num { color: #07c160; font-weight: 700; }
.day-cell.selected { background: #f0fff5; }
.day-cell.selected .day-num { color: #07c160; font-weight: 700; }

.day-shift-label {
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  font-size: 18rpx;
  color: #fff;
  max-width: 80rpx;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ========== 选中日期信息卡 ========== */
.date-card {
  margin-top: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.dc-top { display: flex; align-items: center; }
.dc-color { width: 12rpx; height: 56rpx; border-radius: 6rpx; margin-right: 20rpx; }
.dc-info { display: flex; flex-direction: column; }
.dc-date { font-size: 24rpx; color: #999; }
.dc-name { font-size: 36rpx; font-weight: 600; color: #333; }
.dc-time { font-size: 24rpx; color: #999; }
/* 备注小字 */
.dc-note {
  font-size: 22rpx;
  color: #ed6a0c;
  margin-top: 6rpx;
  background: #fff3e8;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  display: inline-block;
  max-width: 320rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.dc-actions { display: flex; gap: 20rpx; }
.dc-btn {
  font-size: 26rpx; color: #07c160; padding: 12rpx 28rpx;
  border: 1rpx solid #07c160; border-radius: 12rpx;
}
.dc-clear { color: #ff3b30; border-color: #ff3b30; }

/* ========== 日程联动区域 ========== */
.section-label {
  font-size: 26rpx;
  color: #666;
  font-weight: 500;
  display: block;
  margin-bottom: 14rpx;
}

.schedule-section {
  margin-top: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.schedule-item {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.schedule-item:last-child { border-bottom: none; }

.schedule-title {
  font-size: 28rpx;
  color: #333;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.schedule-time {
  font-size: 24rpx;
  color: #576b95;
  background: #e8f0fb;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  flex-shrink: 0;
}

.schedule-repeat-tag {
  font-size: 24rpx;
  flex-shrink: 0;
}

.schedule-done {
  opacity: 0.5;
}
.schedule-done .schedule-title {
  text-decoration: line-through;
  color: #999;
}

/* ========== 换班弹窗 ========== */
.adjust-mask {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.45); z-index: 999;
  display: flex; align-items: flex-end; justify-content: center;
}
.adjust-panel {
  width: 100%; background: #fff; border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 32rpx 48rpx;
}
.adj-title { font-size: 30rpx; color: #333; font-weight: 600; display: block; margin-bottom: 24rpx; }
.adj-options { display: flex; flex-wrap: wrap; gap: 20rpx; margin-bottom: 28rpx; }
.adj-option {
  font-size: 28rpx; color: #333; background: #f5f5f5;
  padding: 20rpx 36rpx; border-radius: 12rpx;
}
.adj-option:active { background: #07c160; color: #fff; }

/* 备注输入区域 */
.adj-note-wrap {
  margin-bottom: 28rpx;
}
.adj-note-label {
  font-size: 26rpx;
  color: #999;
  display: block;
  margin-bottom: 12rpx;
}
.adj-note-input-box {
  display: flex;
  align-items: center;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 0 24rpx;
}
.adj-note-input {
  flex: 1;
  height: 80rpx;
  font-size: 28rpx;
  color: #333;
}
.adj-note-count {
  font-size: 22rpx;
  color: #ccc;
  flex-shrink: 0;
  margin-left: 12rpx;
}

.adj-cancel { display: block; text-align: center; font-size: 28rpx; color: #999; }
