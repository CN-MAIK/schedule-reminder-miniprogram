/* 排班设置页样式 */

.container { min-height: 100vh; background: #f8f9fa; }

/* ========== 模板选择页 ========== */
.template-header { padding: 32rpx 28rpx 12rpx; }
.tmpl-title { font-size: 36rpx; font-weight: 700; color: #1a1a1a; display: block; margin-bottom: 8rpx; }
.tmpl-desc { font-size: 26rpx; color: #999; }

.presets-list { padding: 0 24rpx; }
.preset-card {
  background: #fff; border-radius: 16rpx; padding: 28rpx;
  margin-bottom: 20rpx; border: 2rpx solid transparent;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.03);
}
.preset-card.card-active { border-color: #07c160; background: #f0fff5; }
.preset-top { display: flex; align-items: center; margin-bottom: 8rpx; }
.preset-check {
  width: 40rpx; height: 40rpx; border-radius: 50%;
  border: 2rpx solid #d9d9d9; margin-right: 16rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 24rpx; color: #fff;
}
.preset-check.chk-on { background: #07c160; border-color: #07c160; }
.preset-name { font-size: 32rpx; font-weight: 600; color: #333; }
.preset-desc { font-size: 24rpx; color: #999; margin-left: 56rpx; display: block; margin-bottom: 8rpx; }
.preset-seq { margin-left: 56rpx; display: flex; margin-bottom: 12rpx; }
.preset-seq-label { font-size: 24rpx; color: #bbb; }
.preset-seq-text { font-size: 24rpx; color: #07c160; }
.preset-shifts { margin-left: 56rpx; display: flex; gap: 12rpx; }
.preset-shift { font-size: 20rpx; padding: 4rpx 16rpx; border-radius: 8rpx; }

.tmpl-bottom { padding: 24rpx 28rpx 48rpx; }
.custom-link { text-align: center; margin-top: 24rpx; font-size: 26rpx; color: #07c160; }

/* ========== 编辑面板 ========== */
.edit-header {
  display: flex; align-items: center;
  padding: 20rpx 16rpx; background: #fff; border-bottom: 1rpx solid #eee;
}
.back-btn { width: 64rpx; height: 64rpx; display: flex; align-items: center; justify-content: center; }
.back-arrow { font-size: 48rpx; color: #07c160; font-weight: 300; line-height: 1; }
.edit-title { font-size: 32rpx; font-weight: 600; color: #333; }

.form-group { margin: 20rpx 24rpx; }
.form-label { font-size: 26rpx; color: #666; display: block; margin-bottom: 12rpx; }
.form-picker {
  font-size: 28rpx; color: #333; background: #fff;
  padding: 20rpx 24rpx; border-radius: 12rpx;
}
.form-hint { font-size: 22rpx; color: #bbb; margin-top: 8rpx; display: block; }

.seq-input {
  font-size: 28rpx; color: #333; background: #fff;
  padding: 20rpx 24rpx; border-radius: 12rpx;
}

.shift-row {
  display: flex; align-items: center;
  background: #fff; padding: 16rpx 20rpx;
  border-radius: 12rpx; margin-bottom: 12rpx;
}
.shift-name-col { width: 130rpx; display: flex; align-items: center; gap: 8rpx; }
.shift-name { font-size: 28rpx; color: #333; font-weight: 500; }
.shift-del { font-size: 24rpx; color: #ff3b30; padding: 4rpx; }
.shift-color-col { flex: 1; display: flex; align-items: center; gap: 12rpx; }
.color-input { font-size: 26rpx; flex: 1; }
.color-preview { width: 40rpx; height: 40rpx; border-radius: 8rpx; flex-shrink: 0; }
.shift-time-col { flex: 1; display: flex; align-items: center; gap: 6rpx; }
.time-input { font-size: 24rpx; width: 90rpx; text-align: center; background: #f5f5f5; border-radius: 6rpx; padding: 8rpx 4rpx; }
.time-sep { font-size: 22rpx; color: #ccc; }

.check-msg { text-align: center; font-size: 26rpx; color: #ff3b30; padding: 12rpx; }

.edit-actions { padding: 24rpx 24rpx 48rpx; }
.save-btn {
  width: 100%; background: #07c160; color: #fff;
  font-size: 32rpx; font-weight: 600; border-radius: 12rpx;
  padding: 22rpx; margin: 0; border: none;
}
.save-btn[disabled] { background: #ccc; }
.delete-link {
  display: block; text-align: center; font-size: 26rpx;
  color: #ff3b30; margin-top: 24rpx;
}

.add-shift-row {
  background: #fff; padding: 20rpx; border-radius: 12rpx;
  text-align: center; border: 2rpx dashed #d9d9d9;
}
.add-shift-text { font-size: 26rpx; color: #07c160; }
