/* 排班首页样式 */

.container {
  min-height: 100vh;
  background-color: #f8f9fa;
  padding-bottom: 40rpx;
}

/* ========== 空状态引导 ========== */
.empty-guide {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 240rpx;
}
.guide-icon { font-size: 128rpx; margin-bottom: 32rpx; }
.guide-title { font-size: 36rpx; color: #333; font-weight: 600; margin-bottom: 12rpx; }
.guide-desc { font-size: 26rpx; color: #999; margin-bottom: 48rpx; }
.guide-btn {
  background-color: #07c160;
  color: #fff;
  font-size: 30rpx;
  border-radius: 40rpx;
  padding: 16rpx 60rpx;
}

/* ========== 今日班次大卡片 ========== */
.today-card {
  position: relative;
  margin: 24rpx 24rpx 0;
  border-radius: 20rpx;
  overflow: hidden;
  min-height: 240rpx;
}
.today-bg {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  opacity: 0.85;
}
.today-content {
  position: relative;
  z-index: 1;
  padding: 40rpx 36rpx;
  display: flex;
  flex-direction: column;
}
.today-label {
  font-size: 26rpx;
  color: rgba(255,255,255,0.8);
  margin-bottom: 16rpx;
}
.today-shift-name {
  font-size: 64rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 4rpx;
}
.today-shift-time {
  font-size: 28rpx;
  color: rgba(255,255,255,0.85);
  margin-top: 8rpx;
}

/* ========== 倒计时 ========== */
.countdown {
  margin: 20rpx 24rpx;
  padding: 24rpx 28rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.countdown-text {
  font-size: 28rpx;
  color: #333;
}
.countdown-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #07c160;
}

/* ========== 区域标题 ========== */
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  padding: 0 28rpx;
  margin-bottom: 16rpx;
}

/* ========== 近期排班横向滑动 ========== */
.upcoming-wrap {
  margin: 0 0 24rpx;
}
.upcoming-scroll {
  white-space: nowrap;
  padding: 0 24rpx;
}
.upcoming-day {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  width: 120rpx;
  padding: 16rpx 0;
  margin-right: 16rpx;
  background: #fff;
  border-radius: 16rpx;
  white-space: normal;
}
.upcoming-day.day-today {
  background: #e8f8ee;
  border: 2rpx solid #07c160;
}
.ud-weekday { font-size: 22rpx; color: #999; }
.ud-date { font-size: 30rpx; color: #333; font-weight: 600; margin: 4rpx 0 8rpx; }
.ud-shift {
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  color: #fff;
}
.ud-none {
  background: #eee;
  color: #ccc;
}

/* ========== 本月统计 ========== */
.stats-section {
  margin: 0 24rpx 24rpx;
  padding: 24rpx 28rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.stats-section .section-title {
  padding: 0;
  margin-bottom: 20rpx;
}
.stats-bar {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 16rpx;
}
.stat-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 12rpx 20rpx;
}
.stat-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}
.stat-name { font-size: 24rpx; color: #666; }
.stat-count { font-size: 26rpx; color: #333; font-weight: 600; }
.stats-total {
  font-size: 24rpx;
  color: #aaa;
}

/* ========== 快捷入口 ========== */
.quick-actions {
  margin: 0 24rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.quick-btn {
  display: flex;
  align-items: center;
  padding: 28rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.quick-btn:last-child { border-bottom: none; }
.quick-icon { font-size: 36rpx; margin-right: 20rpx; }
.quick-label { font-size: 28rpx; color: #333; flex: 1; }
.quick-arrow { font-size: 32rpx; color: #ccc; }
