/* 添加/编辑日程页面样式 */

.container {
  padding: 40rpx 32rpx;
  min-height: 100vh;
  background-color: #f8f9fa;
}

.header { margin-bottom: 48rpx; }
.title {
  font-size: 44rpx;
  font-weight: 700;
  color: #1a1a1a;
}

/* 表单 */
.form {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 0 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.form-item {
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.form-item:last-child { border-bottom: none; }
.label { display: block; font-size: 26rpx; color: #999; margin-bottom: 12rpx; }

.input { font-size: 32rpx; color: #1a1a1a; height: 56rpx; line-height: 56rpx; }

.picker-display { display: flex; justify-content: space-between; align-items: center; height: 56rpx; line-height: 56rpx; }
.picker-text { font-size: 32rpx; color: #1a1a1a; }
.picker-placeholder { font-size: 32rpx; color: #ccc; }
.picker-arrow { font-size: 28rpx; color: #ccc; }

.switch-item { display: flex; justify-content: space-between; align-items: center; }
.switch-item .label { margin-bottom: 0; }

.textarea { font-size: 30rpx; color: #1a1a1a; width: 100%; min-height: 160rpx; line-height: 1.6; }

.save-btn {
  margin-top: 64rpx;
  background-color: #07c160;
  color: #fff;
  font-size: 34rpx; font-weight: 600;
  border-radius: 48rpx;
  height: 96rpx; line-height: 96rpx;
  border: none;
}
.save-btn[disabled] { background-color: #9ed8b3; color: #fff; }
.save-btn:not([disabled]):active { opacity: 0.85; }

/* ==================== 重复设置弹窗 ==================== */
.popup-mask {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.4);
  z-index: 100;
}
.popup-panel {
  position: fixed; left: 0; right: 0; bottom: 0;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  z-index: 101;
  transform: translateY(100%);
  transition: transform 0.3s ease;
  max-height: 75vh;
  display: flex;
  flex-direction: column;
}
.popup-panel.show { transform: translateY(0); }

.popup-header {
  display: flex; justify-content: space-between; align-items: center;
  padding: 36rpx 36rpx 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.popup-title { font-size: 34rpx; font-weight: 600; color: #1a1a1a; }
.popup-close { font-size: 36rpx; color: #999; padding: 8rpx; }

.popup-body {
  flex: 1;
  padding: 24rpx 36rpx;
  max-height: 50vh;
  overflow-y: auto;
}

/* 分组标题 */
.repeat-option-group { margin-bottom: 32rpx; }
.repeat-group-title {
  font-size: 26rpx; color: #999;
  margin-bottom: 16rpx;
  display: block;
}

/* 频率选项 */
.repeat-options { display: flex; gap: 16rpx; flex-wrap: wrap; }
.repeat-opt {
  font-size: 28rpx; color: #666;
  padding: 14rpx 32rpx;
  border-radius: 100rpx;
  background: #f5f5f5;
  border: 2rpx solid transparent;
}
.repeat-opt.active { color: #07c160; background: #e8f8ee; border-color: #07c160; }

/* 每周几选择 */
.weekday-picker { display: flex; gap: 10rpx; flex-wrap: wrap; }
.wk-chip {
  font-size: 26rpx; color: #666;
  padding: 12rpx 24rpx;
  border-radius: 100rpx;
  background: #f5f5f5;
}
.wk-chip.on { color: #07c160; background: #e8f8ee; font-weight: 600; }

/* 截止方式切换 */
.switch-bar { display: flex; background: #f5f5f5; border-radius: 100rpx; padding: 6rpx; }
.switch-opt {
  flex: 1; text-align: center;
  font-size: 28rpx; color: #999;
  padding: 14rpx 0;
  border-radius: 100rpx;
}
.switch-opt.active { color: #fff; background: #07c160; }

/* 次数输入 */
.count-input-row { display: flex; align-items: center; gap: 12rpx; }
.count-input {
  width: 160rpx; height: 72rpx;
  border: 2rpx solid #e5e5e5;
  border-radius: 12rpx;
  text-align: center;
  font-size: 32rpx; color: #333;
}
.count-unit { font-size: 28rpx; color: #999; }

.hint {
  font-size: 24rpx; color: #ccc;
  margin-top: 12rpx;
  display: block;
}

/* 弹窗底部按钮 */
.popup-footer {
  display: flex; gap: 24rpx;
  padding: 24rpx 36rpx 60rpx;
  border-top: 1rpx solid #f0f0f0;
}
.popup-btn {
  flex: 1;
  height: 88rpx; line-height: 88rpx;
  font-size: 32rpx; font-weight: 600;
  border-radius: 44rpx;
  border: none;
}
.popup-btn.cancel { background: #f5f5f5; color: #666; }
.popup-btn.confirm { background: #07c160; color: #fff; }
